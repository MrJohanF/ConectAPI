<?xml version="1.0" encoding="utf-8"?>
<!-- C2 · Detalle del producto -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra"
        style="@style/BarraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_atras"
        app:title="@string/detalle_de_la_api" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtLogo"
                    style="@style/LogoApi"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_medio"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombre"
                        style="@style/Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/txtVendedor"
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:drawableEnd="@drawable/ic_estrella_pequena" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtDescripcion"
                style="@style/Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen"
                android:lineSpacingExtra="3dp"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_medio"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCategoria"
                    style="@style/EtiquetaEstado"
                    android:backgroundTint="@color/azul_claro"
                    android:textColor="@color/azul" />

                <TextView
                    style="@style/EtiquetaEstado"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/verde_claro"
                    android:text="@string/rest"
                    android:textColor="@color/verde" />

                <TextView
                    style="@style/EtiquetaEstado"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/naranja_claro"
                    android:text="@string/docs_en_espanol"
                    android:textColor="@color/naranja" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_grande"
                android:text="@string/elige_un_plan" />

            <!-- Los planes se agregan por codigo usando item_plan.xml -->
            <LinearLayout
                android:id="@+id/listaPlanes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnProbar"
                style="@style/Boton.Borde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen"
                android:text="@string/probar_la_api"
                app:icon="@drawable/ic_probar"
                app:iconGravity="textStart" />
        </LinearLayout>
    </ScrollView>

    <!-- Boton fijo abajo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:padding="@dimen/margen">

        <Button
            android:id="@+id/btnAgregar"
            style="@style/Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/agregar_al_carrito"
            app:icon="@drawable/ic_carrito"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
