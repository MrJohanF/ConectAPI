<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal de cada rol. La usan Comprador, Vendedor y Administrador.
     Tiene: barra superior, espacio para los fragments, menu inferior y menu lateral (drawer). -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cajon"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/BarraSuperior"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_menu">

            <!-- Etiqueta con el nombre del rol. Su color sale del tema -->
            <TextView
                android:id="@+id/txtRol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/margen"
                android:background="@drawable/bg_etiqueta_rol"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/borde" />

        <!-- Aqui se cambian los fragments -->
        <FrameLayout
            android:id="@+id/contenedor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/menuInferior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/superficie"
            app:itemIconTint="@color/selector_menu_inferior"
            app:itemTextColor="@color/selector_menu_inferior"
            app:labelVisibilityMode="labeled" />
    </LinearLayout>

    <!-- Menu lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/menuLateral"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/superficie"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/selector_menu_inferior"
        app:itemTextColor="@color/texto" />
</androidx.drawerlayout.widget.DrawerLayout>
