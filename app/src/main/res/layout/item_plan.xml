<?xml version="1.0" encoding="utf-8"?>
<!-- Plan de precio. El fondo bg_plan cambia cuando la vista esta seleccionada -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margen_pequeno"
    android:background="@drawable/bg_plan"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="6dp"
    android:paddingEnd="@dimen/margen">

    <RadioButton
        android:id="@+id/radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombre"
            style="@style/Texto.Negrita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtLlamadas"
            style="@style/Texto.Suave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPrecio"
        style="@style/Texto.Negrita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
