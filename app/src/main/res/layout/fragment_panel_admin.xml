<?xml version="1.0" encoding="utf-8"?>
<!-- A1 · Dashboard principal del administrador -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_medio">

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/resumen_de_la_tienda" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:orientation="horizontal">

            <include
                android:id="@+id/metrica1"
                layout="@layout/tarjeta_metrica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/metrica2"
                layout="@layout/tarjeta_metrica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/metrica3"
                layout="@layout/tarjeta_metrica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/metrica4"
                layout="@layout/tarjeta_metrica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/margen"
            android:text="@string/accesos_rapidos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUsuarios"
                style="@style/Boton.Borde"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="@string/usuarios"
                android:textColor="@color/texto"
                app:icon="@drawable/ic_usuarios"
                app:iconGravity="top"
                app:iconTint="?attr/colorPrimary" />

            <Button
                android:id="@+id/btnProductos"
                style="@style/Boton.Borde"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="@string/productos"
                android:textColor="@color/texto"
                app:icon="@drawable/ic_productos"
                app:iconGravity="top"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCategorias"
                style="@style/Boton.Borde"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="@string/categorias"
                android:textColor="@color/texto"
                app:icon="@drawable/ic_categoria"
                app:iconGravity="top"
                app:iconTint="?attr/colorPrimary" />

            <Button
                android:id="@+id/btnReportes"
                style="@style/Boton.Borde"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="@string/reportes"
                android:textColor="@color/texto"
                app:icon="@drawable/ic_recibo"
                app:iconGravity="top"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/margen"
            android:text="@string/ultimos_movimientos" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp">

            <TextView
                style="@style/Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/margen"
                android:text="@string/nuevo_vendedor_pendiente_datapaz_n" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
