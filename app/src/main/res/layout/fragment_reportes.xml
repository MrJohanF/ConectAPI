<?xml version="1.0" encoding="utf-8"?>
<!-- A6 · Reporte de ventas -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_medio">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoPeriodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:checkedChip="@id/chipMes"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMes"
                style="@style/ChipFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/este_mes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTrimestre"
                style="@style/ChipFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trimestre" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAnio"
                style="@style/ChipFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ano" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:orientation="horizontal">

            <include
                android:id="@+id/metrica1"
                layout="@layout/tarjeta_metrica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/metrica2"
                layout="@layout/tarjeta_metrica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/margen"
            android:text="@string/ventas_por_semana" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp">

            <!-- Las barras se agregan por codigo con item_barra.xml -->
            <LinearLayout
                android:id="@+id/grafica"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:orientation="horizontal"
                android:padding="@dimen/margen" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="@dimen/margen"
            android:text="@string/apis_mas_vendidas" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp">

            <!-- TableLayout para mostrar el ranking en columnas -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/margen"
                android:stretchColumns="0">

                <TableRow android:paddingVertical="4dp">
                    <TextView style="@style/Texto" android:text="@string/t_1_pagofacil_api" />
                    <TextView style="@style/Texto.Negrita" android:text="@string/t_212" />
                </TableRow>

                <TableRow android:paddingVertical="4dp">
                    <TextView style="@style/Texto" android:text="@string/t_2_facturaya" />
                    <TextView style="@style/Texto.Negrita" android:text="@string/t_148" />
                </TableRow>

                <TableRow android:paddingVertical="4dp">
                    <TextView style="@style/Texto" android:text="@string/t_3_georuta_colombia" />
                    <TextView style="@style/Texto.Negrita" android:text="@string/t_97" />
                </TableRow>
            </TableLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnDescargar"
            style="@style/Boton.Borde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/descargar_reporte_pdf"
            app:icon="@drawable/ic_recibo"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
