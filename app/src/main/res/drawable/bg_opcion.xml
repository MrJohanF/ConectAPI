<?xml version="1.0" encoding="utf-8"?>
<!-- Fila blanca redondeada con efecto al tocar -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/borde">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <stroke android:width="1dp" android:color="@color/borde" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
