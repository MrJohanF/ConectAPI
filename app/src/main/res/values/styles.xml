<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== TEXTOS ===== -->
    <style name="Texto">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Texto.Titulo">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Texto.Subtitulo">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.Negrita">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.Suave">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Texto.Etiqueta">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Texto.Numero">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== BOTONES ===== -->
    <style name="Boton" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Boton.Borde" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/borde</item>
        <item name="backgroundTint">@color/superficie</item>
    </style>
    <style name="Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Boton.Pequeno" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Boton.Pequeno.Rojo" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/rojo</item>
        <item name="strokeColor">@color/borde</item>
        <item name="backgroundTint">@color/superficie</item>
    </style>

    <!-- ===== CAMPOS DE TEXTO ===== -->
    <style name="Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radio_boton</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_boton</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_boton</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_boton</item>
        <item name="boxBackgroundColor">@color/superficie</item>
        <item name="boxStrokeColor">@color/selector_borde_campo</item>
        <item name="android:layout_marginTop">@dimen/margen_medio</item>
    </style>

    <!-- Campo con lista desplegable -->
    <style name="Campo.Lista" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radio_boton</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_boton</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_boton</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_boton</item>
        <item name="boxBackgroundColor">@color/superficie</item>
        <item name="boxStrokeColor">@color/selector_borde_campo</item>
        <item name="android:layout_marginTop">@dimen/margen_medio</item>
    </style>

    <!-- ===== TARJETAS ===== -->
    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radio_tarjeta</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===== CHIPS DE FILTRO ===== -->
    <style name="ChipFiltro" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_chip_fondo</item>
        <item name="android:textColor">@color/selector_chip_texto</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- Etiqueta pequena para estados: Activa, Pendiente, Bloqueado... -->
    <style name="EtiquetaEstado">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_etiqueta</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Cuadro con la letra inicial que funciona como logo de cada API -->
    <style name="LogoApi">
        <item name="android:layout_width">@dimen/logo_api</item>
        <item name="android:layout_height">@dimen/logo_api</item>
        <item name="android:background">@drawable/bg_logo_api</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Fila de opcion en el perfil -->
    <style name="OpcionPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/bg_opcion</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Barra superior -->
    <style name="BarraSuperior" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/superficie</item>
        <item name="titleTextAppearance">@style/Texto.Subtitulo</item>
        <item name="titleTextColor">@color/texto</item>
        <item name="navigationIconTint">?attr/colorPrimary</item>
    </style>
</resources>
